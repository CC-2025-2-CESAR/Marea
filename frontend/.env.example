# Exemplo de variáveis de ambiente do frontend Amare.
# Copie para `.env` (que NÃO é versionado) e ajuste se necessário.

# URL base da API. Em desenvolvimento aponta para o backend local; em produção,
# o endereço público da API (ex.: https://amare.azurewebsites.net/api).
VITE_API_BASE_URL=http://localhost:8000/api
