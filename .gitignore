# .gitignore do projeto Amare (Maréa)
# Stack: backend Django (Python) + frontend React/Vite + testes Cypress.

# --- Python / Django ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Ambiente virtual do backend
venv/
.venv/
env/

# Banco local de desenvolvimento (nunca versionar dados)
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Arquivos estáticos coletados em produção (gerados por collectstatic)
staticfiles/
backend/staticfiles/

# --- Node / React / Vite ---
node_modules/
dist/
dist-ssr/
*.local

# Logs de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cypress (artefatos de execução) ---
cypress/videos/
cypress/screenshots/
cypress/downloads/

# --- Variáveis de ambiente (segredos nunca vão para o repositório) ---
.env
.env.*
!.env.example

# --- Configurações locais do .github ---
# Mantém o .github fora do versionamento (ex.: template de PR). Se no futuro o
# projeto adotar workflows de CI/CD, libere-os com uma exceção, por exemplo:
#   !.github/workflows/
.github/

# --- Sistema operacional / editores ---
.DS_Store
Thumbs.db
*.swp
