# Exemplo de variáveis de ambiente do backend Amare.
# Copie para `.env` (que NÃO é versionado) e ajuste os valores.
# Em desenvolvimento local, nada aqui é obrigatório: os padrões do settings.py
# já funcionam com SQLite e DEBUG ligado.

# Chave secreta do Django. Em produção, gere uma única e mantenha em segredo.
# Ex.: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao

# Liga/desliga o modo de depuração. SEMPRE False em produção.
DJANGO_DEBUG=True

# Hosts liberados (separados por vírgula). Em produção, o domínio real.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do frontend liberadas para CORS (separadas por vírgula).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origens confiáveis para CSRF quando atrás de HTTPS/proxy (produção).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados. Vazio = SQLite local. Em produção, a URL do PostgreSQL.
# Ex.: postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=
